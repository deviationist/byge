# Copy to .env for local development: `make .env`

# MET's terms require an identifying agent WITH CONTACT DETAILS. This is the
# reason the API exists at all — `User-Agent` is a forbidden header in the
# Fetch API, so the browser cannot send one and every request would otherwise
# reach MET anonymous. Put a real address here.
USER_AGENT=byge/0.1 (https://github.com/deviationist/byge; secret.registry@pm.me)

# Browser origins allowed to call the proxy. Empty blocks every browser client,
# which is the safe default rather than an accidentally open one.
ALLOWED_ORIGINS=http://localhost:8081,https://byge.ichiva.no

# A 200 is immutable — the analysis timestamp is in the URL — so successes are
# held for a long time. A 404 means "not published yet" and is the only thing
# that needs re-asking; it alone sets how quickly a new frame is noticed.
CACHE_TTL_OK=1h
CACHE_TTL_MISS=30s
CACHE_MAX_BYTES=67108864

UPSTREAM_TIMEOUT=20s
ADDR=localhost:8080

# Docker only.
APP_BIND=127.0.0.1:8080
RESTART_POLICY=no
