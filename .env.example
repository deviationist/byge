# Copy to .env for local development: `make .env`

# MET's terms require an identifying agent WITH CONTACT DETAILS. This is the
# reason the API exists at all — `User-Agent` is a forbidden header in the
# Fetch API, so the browser cannot send one and every request would otherwise
# reach MET anonymous. Put a real address here.
USER_AGENT=byge/0.1 (https://github.com/deviationist/byge; secret.registry@pm.me)

# Browser origins allowed to call the proxy. Empty blocks every browser client,
# which is the safe default rather than an accidentally open one.
ALLOWED_ORIGINS=http://localhost:8081,https://byge.ichiva.no

# A 200 is immutable — the analysis timestamp is in the URL — so successes are
# held for a long time. A 404 means "not published yet" and is the only thing
# that needs re-asking; it alone sets how quickly a new frame is noticed.
CACHE_TTL_OK=1h
CACHE_TTL_MISS=30s
CACHE_MAX_BYTES=67108864

# Shared client key. Deterrence, not authentication — it is extractable from
# the client bundle. What it buys is that stumbling across the API is not the
# same as being able to use it. Empty disables the check, which is what local
# dev wants. The web app sends it as EXPO_PUBLIC_CLIENT_KEY.
CLIENT_KEY=

# Per-IP volume, generous. This is the protection that actually holds, since
# the key is not scarce.
RATE_PER_MINUTE=60
RATE_BURST=120

# Concurrent upstream fetches. Coalescing collapses identical requests; this
# bounds a hundred DIFFERENT windows going out at once.
MAX_INFLIGHT=8

# true behind nginx (reads X-Real-Ip), false when exposed directly — the header
# is spoofable and would let anyone forge a fresh identity per request.
TRUST_PROXY_HEADERS=false

# development exposes the X-Cache header; production hides it.
APP_ENV=development

UPSTREAM_TIMEOUT=20s
ADDR=localhost:8080

# Docker only.
APP_BIND=127.0.0.1:8080
RESTART_POLICY=no
