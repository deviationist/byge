# Copy to web/.env for local development.
#
# EXPO_PUBLIC_* variables are INLINED INTO THE BUNDLE at build time. Nothing
# here is a secret and nothing here can be — the client key included, which is
# why the API's real bound on volume is a per-IP rate limit rather than the key.

# Which proxy to talk to. Defaults to production when unset, so a plain
# `pnpm run web` works against the deployed API. Point it at a local instance
# only when iterating on the API itself.
# EXPO_PUBLIC_API_BASE=http://localhost:8080

# Shared key for the proxy. Must match CLIENT_KEY on the API side, or every
# request comes back 401.
EXPO_PUBLIC_CLIENT_KEY=
